{
  "key": "daily-call-report",
  "name": "Daily Call Report",
  "description": "Agent-wise dialled call details with the DID mapped to each extension. Joins ccaas_ai (call history) with telecom (DID mapping) across two servers.",
  "environment": "LIVE",

  "params": [
    { "name": "reportDate", "label": "Report date", "type": "date", "default": "today", "required": true },
    { "name": "domainId",   "label": "Domain ID",   "type": "int",  "default": 20704,   "required": true }
  ],

  "steps": [
    {
      "id": "calls",
      "connection": "ccaas_ai",
      "type": "rows",
      "sql": "SELECT tu.UserName AS UserName, tu.UserID AS UserID, tu.emailId AS emailId, tu.ext AS Extension, dp.your_number AS From_Number, tch.customerNumber AS To_Number, ROUND(tch.callDuration / 1000) AS `Call_Duration(sec)`, tcdh.createdAt AS Called_Time FROM tb_CallHistory tch JOIN tb_CallDurationHistory tcdh ON tch.CallHistoryId = tcdh.CallHistoryId JOIN tb_User tu ON tu.UserID = tcdh.AgentId LEFT JOIN did_purchase dp ON dp.user_id = tu.ext AND dp.domainId = tch.domainId WHERE tch.domainId = :domainId AND tcdh.createdAt >= :reportDateFrom AND tcdh.createdAt < :reportDateTo ORDER BY tcdh.createdAt DESC"
    },
    {
      "id": "did_map",
      "connection": "telecom",
      "type": "lookup",
      "sql": "SELECT extension, did_number FROM did_mapping",
      "lookup": { "keyColumn": "extension", "valueColumn": "did_number" }
    }
  ],

  "merge": {
    "base": "calls",
    "enrich": [
      { "from": "did_map", "matchOn": "Extension", "as": "Mapped_DID", "fallback": "" }
    ]
  },

  "email": {
    "to": ["operations@company.com"],
    "cc": [],
    "subject": "Daily Call Report {{reportDateCompact}}",
    "attachAs": "Call_Report_{{reportDateCompact}}.csv",
    "body": "Hi,\n\nPlease find attached the call report for {{reportDate}} (domain {{domainId}}).\n\nRows: {{rowCount}}\nGenerated: {{generatedAt}}\n\nRegards,\nBackupVault Automation"
  }
}
